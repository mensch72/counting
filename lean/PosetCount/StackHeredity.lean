/-
Heredity for stacks: if `y` has the largest strict down-set among all elements of `P`, then every
stack of `P - y` extends to a stack of `P` with the same layers.  Hence the posets without a
large stack can be generated by one-point extensions.
-/
import PosetCount.Stacked

open Finset

namespace PosetCount

variable {P : Type*} [PartialOrder P] [Fintype P] [DecidableEq P]
variable {ι : Type*} [Fintype ι] [DecidableEq ι] [LinearOrder ι]

/-- A stack of the poset `P - y`, written inside `P`: the sets avoid `y`, and the gap condition
is only required for elements other than `y`.  (For a maximal `y`, down-sets of `P - y` are
exactly the down-sets of `P` avoiding `y`.) -/
def IsStackAvoiding (y : P) (f : ι → Finset P × Finset P) : Prop :=
  (∀ j, IsLowerSet ((f j).1 : Set P) ∧ IsLowerSet ((f j).2 : Set P) ∧ (f j).1 ⊆ (f j).2 ∧
    y ∉ (f j).2 ∧ ∀ x v, x < v → v ∈ (f j).2 → x ∈ (f j).1) ∧
  ∀ j j', j < j' → (f j).2 ⊆ (f j').1 ∧ ∀ x ∈ (f j).2, ∀ v, v ≠ y → v ∉ (f j').1 → x < v

open Classical in
/-- **Heredity.** Let `y` have the largest strict down-set in `P`.  Then every stack of `P - y`
gives a stack of `P` of the same size. -/
theorem exists_stack_of_avoiding (y : P)
    (hy : ∀ u : P, (univ.filter (· < u)).card ≤ (univ.filter (· < y)).card)
    (f : ι → Finset P × Finset P) (hf : IsStackAvoiding y f) :
    ∃ f' : ι → Finset P × Finset P, IsStack f' ∧ stackSize f' = stackSize f := by
  -- `y` is maximal
  have hymax : ∀ v : P, ¬ y < v := by
    intro v hyv
    have hsub : insert y (univ.filter (· < y)) ⊆ univ.filter (· < v) := by
      intro x hx
      rcases mem_insert.1 hx with rfl | hx
      · simpa using hyv
      · have : x < y := by simpa using hx
        simpa using this.trans hyv
    have h1 := card_le_card hsub
    rw [card_insert_of_notMem (by simp)] at h1
    have h2 := hy v
    omega
  -- key fact: an element `v ≠ y` above a whole `I_j` that contains the strict down-set of `y`
  -- has exactly the strict down-set of `y`
  have key : ∀ (j : ι) (v : P), (∀ x, x < y → x ∈ (f j).2) → (∀ x ∈ (f j).2, x < v) →
      ∀ x, x < v → x < y := by
    intro j v hD hv x hxv
    have hsub : univ.filter (· < y) ⊆ univ.filter (· < v) := by
      intro z hz
      have hz' : z < y := by simpa using hz
      simpa using hv z (hD z hz')
    have heq : univ.filter (· < y) = univ.filter (· < v) :=
      eq_of_subset_of_card_le hsub (hy v)
    have : x ∈ univ.filter (· < v) := by simpa using hxv
    rw [← heq] at this
    simpa using this
  -- the indices at which `y` is added
  let J : ι → Prop := fun j => (∀ x, x < y → x ∈ (f j).1) ∧
    ∀ j', j < j' → ∀ v, v ≠ y → v ∈ (f j').1
  have hJup : ∀ j j', j < j' → J j → J j' := by
    intro j j' hjj' hJ
    refine ⟨fun x hx => ?_, fun j'' hj'' v hv => hJ.2 j'' (hjj'.trans hj'') v hv⟩
    exact (hf.2 j j' hjj').1 ((hf.1 j).2.2.1 (hJ.1 x hx))
  refine ⟨fun j => if J j then (insert y (f j).1, insert y (f j).2) else f j, ⟨?_, ?_⟩, ?_⟩
  · -- conditions for a single index
    intro j
    obtain ⟨a1, a2, a3, a4, a5⟩ := hf.1 j
    by_cases hJ : J j
    · simp only [hJ, if_true]
      refine ⟨?_, ?_, insert_subset_insert _ a3, ?_⟩
      · intro u z hzu hu
        rcases mem_insert.1 (by exact_mod_cast hu) with rfl | hu
        · rcases eq_or_lt_of_le hzu with rfl | hlt
          · exact_mod_cast mem_insert_self _ _
          · exact_mod_cast mem_insert_of_mem (hJ.1 z hlt)
        · exact_mod_cast mem_insert_of_mem (a1 hzu (by exact_mod_cast hu))
      · intro u z hzu hu
        rcases mem_insert.1 (by exact_mod_cast hu) with rfl | hu
        · rcases eq_or_lt_of_le hzu with rfl | hlt
          · exact_mod_cast mem_insert_self _ _
          · exact_mod_cast mem_insert_of_mem (a3 (hJ.1 z hlt))
        · exact_mod_cast mem_insert_of_mem (a2 hzu (by exact_mod_cast hu))
      · intro x v hxv hv
        rcases mem_insert.1 hv with rfl | hv
        · exact mem_insert_of_mem (hJ.1 x hxv)
        · exact mem_insert_of_mem (a5 x v hxv hv)
    · simp only [hJ, if_false]
      exact ⟨a1, a2, a3, a5⟩
  · -- nesting and gaps
    intro j j' hjj'
    obtain ⟨b1, b2⟩ := hf.2 j j' hjj'
    constructor
    · by_cases hJ : J j
      · have hJ' := hJup j j' hjj' hJ
        simp only [hJ, hJ', if_true]
        exact insert_subset_insert _ b1
      · by_cases hJ' : J j'
        · simp only [hJ, hJ', if_true, if_false]
          exact b1.trans (subset_insert _ _)
        · simp only [hJ, hJ', if_false]
          exact b1
    · intro x hx v hv
      by_cases hJ : J j
      · -- then nothing other than `y` is outside `I'_{j'}`
        have hJ' := hJup j j' hjj' hJ
        simp only [hJ', if_true] at hv
        have hvy : v ≠ y := fun h => hv (h ▸ mem_insert_self _ _)
        exact absurd (mem_insert_of_mem (hJ.2 j' hjj' v hvy)) hv
      · simp only [hJ, if_false] at hx
        by_cases hvy : v = y
        · subst hvy
          have hJ' : ¬ J j' := by
            intro hJ'
            simp only [hJ', if_true] at hv
            exact hv (mem_insert_self _ _)
          -- either the down-set of `y` is not inside `I'_{j'}`, or a later index misses some `v`
          by_cases hD : ∀ z, z < v → z ∈ (f j').1
          · have : ¬ ∀ j'', j' < j'' → ∀ u, u ≠ v → u ∈ (f j'').1 := fun h => hJ' ⟨hD, h⟩
            push Not at this
            obtain ⟨j'', hj'', u, huv, hu⟩ := this
            have hxu : x < u := (hf.2 j j'' (hjj'.trans hj'')).2 x hx u huv hu
            refine key j' u (fun z hz => (hf.1 j').2.2.1 (hD z hz)) ?_ x hxu
            intro z hz
            exact (hf.2 j' j'' hj'').2 z hz u huv hu
          · push Not at hD
            obtain ⟨z, hzv, hz⟩ := hD
            have hzne : z ≠ v := hzv.ne
            exact (b2 x hx z hzne hz).trans hzv
        · have hv' : v ∉ (f j').1 := by
            by_cases hJ' : J j'
            · simp only [hJ', if_true] at hv
              exact fun h => hv (mem_insert_of_mem h)
            · simpa only [hJ', if_false] using hv
          exact b2 x hx v hvy hv'
  · -- sizes agree
    unfold stackSize
    refine sum_congr rfl (fun j _ => ?_)
    by_cases hJ : J j
    · have hy2 : y ∉ (f j).2 := (hf.1 j).2.2.2.1
      have hy1 : y ∉ (f j).1 := fun h => hy2 ((hf.1 j).2.2.1 h)
      simp only [hJ, if_true]
      rw [card_insert_of_notMem hy1, card_insert_of_notMem hy2]
      push_cast
      ring
    · simp only [hJ, if_false]

end PosetCount
